-- Q12 Analyze the cumulative revenue generated over time. 

-- REVENUE GENERATED EACH DAY, AND GIVING A CUMMULATIVE FIGURE OVER THE ENTIRE TIME

select Order_DAY, Day_Rev,
sum(Day_Rev) over (order by Order_DAY) as Cumm_REV
from
(select orders.order_date as Order_DAY,
round(sum( order_details.quantity * pizzas.price),0) as Day_REV
from order_details
join pizzas
on order_details.pizza_id = pizzas.pizza_id
join orders
on order_details.order_id = orders.order_id
group by Order_DAY) as Day_Sales;

