Q9 Group the orders by date and calculate the average number of pizzas ordered per day.

 select round(avg(Total_Order),00) as Average_Order_Per_Day_YEAR from -- avg round is zero as order cant be a half or decimal order.
(select orders.order_date as OrdDate, sum(order_details.quantity) as Total_Order
from orders
join order_details
on orders.order_id = order_details.order_id
group by OrdDate) 
as Total_Annual_Order
;

Q10 -- Determine the top 3 most ordered pizza types based on revenue.

SELECT 
    pizzas.pizza_type_id AS PIZZA_TYPE,
    ROUND(SUM(order_details.quantity * pizzas.price),0) AS REVENUE,
    pizza_types.name AS PIZZA_NAME, pizza_types.ingredients AS CONTAINS
FROM
    pizzas
        JOIN
    order_details ON pizzas.pizza_id = order_details.pizza_id
    JOIN pizza_types 
ON pizzas.pizza_type_id = pizza_types.pizza_type_id
GROUP BY pizzas.pizza_type_id,PIZZA_NAME, CONTAINS
order by REVENUE DESC limit 3; 
-- A SELECT FROM A DIFFERENT TABLE REQUIRES A JOIN AND ALSO GOES INTO GROUP, WITHOUT BEING IN THE GROUP A COLUMN FROM A DIFFERENT TABLE WONT WORK, HERE TWO COLUMN FROM A DIFFERENT TABLE THAT BEING NAME AND INGRIDENET(AS CONTAINS) WAS ADDED, SIMILARLY IF A COLUMN WAS ADDED FROM PIZZAS.PIZZATYPE ID, JOIN WONT BE REQUIRED AS IS ALREADY JOIN USED. 

