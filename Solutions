-- Q13 Determine the top 3 most ordered pizza types based on revenue for each pizza category.
-- things needed, Revenue for each pizza CAtergory, Pizza types most ordered, 
select P_NAME, Revenue, P_Category,Rnk from
(select P_Category, P_NAME, Revenue,
rank () over(partition by P_Category order by Revenue desc ) as Rnk
from (select pizza_types.category as P_Category, pizza_types.pizza_type_id, pizza_types.name as P_NAME,
sum(order_details.quantity*pizzas.price) as Revenue from
pizzas
join 
pizza_types
on 
pizza_types.pizza_type_id = pizzas.pizza_type_id
join
order_details
on
pizzas.pizza_id = order_details.pizza_id
group by P_Category, pizza_types.pizza_type_id,P_NAME
) as RevCAT) as RNKCAT
where Rnk <=3
 ;
